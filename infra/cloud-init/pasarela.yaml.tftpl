#cloud-config
# Pasarela: Caddy como proxy inverso HTTPS hacia nodo1.incus y nodo2.incus (por nombre).
package_update: true
packages:
  - caddy

write_files:
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      {
        # Los navegadores no envian SNI cuando se entra por IP; ademas el proxy de Incus
        # entrega la conexion por 127.0.0.1. default_sni indica que certificado usar.
        default_sni ${dominio}
      }
      ${dominio} {
      %{ if tls_interno ~}
        tls internal
      %{ endif ~}
        encode gzip
        redir /nodo1 /nodo1/
        redir /nodo2 /nodo2/
        handle_path /nodo1/* {
          reverse_proxy nodo1.incus:${puerto}
        }
        handle_path /nodo2/* {
          reverse_proxy nodo2.incus:${puerto}
        }
        # Entrada principal: balanceo entre los dos nodos por "menos conexiones".
        # Cada WebSocket abierto cuenta como conexion activa, asi que cada usuario nuevo
        # va al nodo con menos usuarios. Si un nodo cae, se usa el otro.
        handle {
          reverse_proxy nodo1.incus:${puerto} nodo2.incus:${puerto} {
            lb_policy least_conn
            lb_try_duration 3s
            fail_duration 30s
          }
        }
      }

runcmd:
  - systemctl enable caddy
  - systemctl restart caddy
