#cloud-config
# Configuracion de ${nombre}: instala Python + aiohttp, copia el servidor y la interfaz web
# y lo deja como servicio systemd.
package_update: true
packages:
  - python3-aiohttp

write_files:
  - path: /opt/mensajero/servidor.py
    encoding: b64
    content: ${servidor_b64}
    permissions: "0755"
  - path: /opt/mensajero/cliente_consola.py
    encoding: b64
    content: ${cliente_b64}
    permissions: "0755"
%{ for archivo, contenido in web ~}
  - path: /opt/mensajero/web/${archivo}
    encoding: b64
    content: ${contenido}
    permissions: "0644"
%{ endfor ~}
  - path: /etc/mensajero.env
    permissions: "0644"
    content: |
      NODO_NOMBRE=${nombre}
      NODO_PAR=${par}
      PUERTO=${puerto}
      PYTHONUNBUFFERED=1
      ICE_SERVERS='${ice_servers}'
  - path: /etc/systemd/system/mensajero.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Mensajero WebRTC - servidor de senalizacion (${nombre})
      After=network-online.target
      Wants=network-online.target

      [Service]
      EnvironmentFile=/etc/mensajero.env
      ExecStart=/usr/bin/python3 /opt/mensajero/servidor.py
      Restart=always
      RestartSec=2
      DynamicUser=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now mensajero.service
